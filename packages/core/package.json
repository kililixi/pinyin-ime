{
  "name": "@startsi/pinyin-core",
  "version": "0.1.0",
  "description": "中文拼音输入法内核：词图 DP、模糊音、简拼、姓名候选、bigram 语言模型。纯 TS，零框架依赖。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lm": {
      "types": "./dist/lm.d.ts",
      "import": "./dist/lm.js",
      "require": "./dist/lm.cjs"
    }
  },
  "files": [
    "dist",
    "lm.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "pinyin",
    "ime",
    "input-method",
    "chinese",
    "t9",
    "九宫格",
    "拼音"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "test": "node test/smoke.mjs"
  },
  "devDependencies": {
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.6.0",
    "typescript": "^4.9.5"
  }
}
