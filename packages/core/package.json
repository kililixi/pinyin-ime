{
  "name": "@startsi/pinyin-core",
  "version": "0.1.1",
  "description": "中文拼音输入法内核：词图 DP、模糊音、简拼、姓名候选、bigram 语言模型。纯 TS，零框架依赖。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lm": {
      "types": "./dist/lm.d.ts",
      "import": "./dist/lm.js",
      "require": "./dist/lm.cjs"
    }
  },
  "files": [
    "dist",
    "lm.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "author": "startsi <matenshi@163.com>",
  "license": "MIT",
  "keywords": [
    "pinyin",
    "ime",
    "input-method",
    "chinese",
    "t9",
    "九宫格",
    "拼音"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kililixi/pinyin-ime.git"
  },
  "homepage": "https://github.com/kililixi/pinyin-ime#readme",
  "bugs": {
    "url": "https://github.com/kililixi/pinyin-ime/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.6.0",
    "typescript": "^4.9.5"
  }
}
