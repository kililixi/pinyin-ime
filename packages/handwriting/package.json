{
  "name": "@startsi/vue-handwriting",
  "version": "0.1.0",
  "description": "Vue3 中文手写板组件：HanScribe 神经网络识别，离线可用，模型可自定义加载。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "author": "startsi <matenshi@163.com>",
  "license": "MIT",
  "keywords": [
    "vue",
    "handwriting",
    "chinese",
    "手写",
    "canvas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kililixi/pinyin-ime.git"
  },
  "homepage": "https://github.com/kililixi/pinyin-ime#readme",
  "bugs": {
    "url": "https://github.com/kililixi/pinyin-ime/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "hanscribe": "^0.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.6.0",
    "vue": "^3.3.8"
  }
}
